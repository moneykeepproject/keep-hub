# Source, scripts and workflows check out with LF on every system, Windows included
# (core.autocrlf would otherwise give CRLF, and the tools and tests read these files line
# by line). `cargo xtask guards` checks it.
*.rs     text eol=lf
*.toml   text eol=lf
*.lock   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.sh     text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.command text eol=lf
*.ps1    text eol=lf
*.nsi    text eol=lf
*.plist  text eol=lf
*.py     text eol=lf
*.html   text eol=lf
*.js     text eol=lf
*.wat    text eol=lf
NOTICE   text eol=lf
LICENSE-* text eol=lf
